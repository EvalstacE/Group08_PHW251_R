# Current Outbreak Status


```{r}
#| include: false
#| warning: false
#| message: false

source("_common04.R")

```



```{r, echo = FALSE}

#######################################
#######################################
##                                   ##
##   Set up dataframes for charts    ##
##                                   ##
#######################################
#######################################
ca_pop <- sum(inf_rates_by_cnty$total_pop)

inf_rates_by_cnty <- inf_rates_by_cnty %>%
  mutate(pop_prop = 100*total_pop / ca_pop)

top_cnty_rates_df <- top_cnty_rates %>%
  st_drop_geometry() %>% 
  mutate(pop_prop = 100*total_pop / ca_pop)

top_inf <- top_cnty_rates_df %>%
  filter(inf_rate_100k > 4648) %>%
  distinct() %>%
  pull(county)

top_sev <- top_cnty_rates_df %>%
  filter(sev_rate_100k > 195) %>%
  distinct() %>%
  pull(county)

top_sev_df <- top_cnty_rates_df %>%
  filter(sev_rate_100k > 195) %>%
  distinct()

top_inf_df <- top_cnty_rates_df %>%
  filter(inf_rate_100k > 4648) %>%
  distinct()


## cases
case_plot_df <- make_case_bar_df(inf_rates_by_cnty, cumulative_infected)

## infection rates
rate_plot_df <- make_case_bar_df(inf_rates_by_cnty, inf_rate_100k)

## severe rates
sev_rate_plot_df <- make_case_bar_df(inf_rates_by_cnty, sev_rate_100k)

## custom county labels (match group factors)
case_label_map     <- make_label_map(case_plot_df)
rate_label_map     <- make_label_map(rate_plot_df)
sev_rate_label_map <- make_label_map(sev_rate_plot_df)



#######################################
#######################################
##                                   ##
##      Create the bar charts        ##
##                                   ##
#######################################
#######################################

case_plot_theme <- list(
  theme = theme( 
    axis.text.y = ggtext::element_markdown(),
    axis.title.y = element_blank(),
    axis.title.x = element_text(margin = margin(t=3)),
    legend.direction = "horizontal",
    legend.title = element_blank(),
    legend.text = element_text(margin = margin(b=5))
  )
)


case_plot_pal <- c("#f1f0ea", "#b93f76", "#6a1c6c")


p_cases <- ggplot(case_plot_df) +
  geom_col(aes(x = cumulative_infected, y = county, fill = rate_top)) +
  scale_y_discrete(labels = function(x) case_label_map[x]) +
  scale_fill_manual(values = case_plot_pal) +
  labs(
    x = "Total Infections"
  ) +
  theme_classic()+
  case_plot_theme$theme

p_rates <- ggplot(rate_plot_df) +
  geom_col(aes(x = inf_rate_100k, y = county, fill = rate_top)) +
  scale_y_discrete(labels = function(x) rate_label_map[x]) +
  scale_fill_manual(values = case_plot_pal) +
    labs(
    x = "Infections per 100K"
  ) +
  theme_classic()+
  case_plot_theme$theme


p_sev_rates <- ggplot(sev_rate_plot_df) +
  geom_col(aes(x = sev_rate_100k, y = county, fill = rate_top)) +
  scale_y_discrete(labels = function(x) sev_rate_label_map[x]) +
  scale_fill_manual(values = case_plot_pal) +
    labs(
    x = "Severe Infections per 100K"
  ) +
  theme_classic()+
  case_plot_theme$theme



#######################################
#######################################
##                                   ##
##     Combine into single plot      ##
##                                   ##
#######################################
#######################################
##-- shared legend
shared_legend <- cowplot::get_legend(p_cases)

p_cases_noleg     <- p_cases     + theme(legend.position = "none") 
p_rates_noleg     <- p_rates     + theme(legend.position = "none")
p_sev_rates_noleg <- p_sev_rates + theme(legend.position = "none")

##-- combine plots into grid
panel_row <- cowplot::plot_grid(
  p_cases_noleg,
  p_rates_noleg,
  p_sev_rates_noleg,
  nrow = 1,
  rel_widths = c(1, 1, 1)
)

##-- final layout
combined_plot <- cowplot::plot_grid(
  shared_legend,
  panel_row,
  ncol = 1,
  rel_heights = c(0.05, 1)
)

```



```{r, echo = FALSE}


p_df <- inf_rates_by_cnty %>% 
  filter(county != "Los Angeles")


p1 <- ggplot() + 
  
geom_point(
  data = p_df, 
  shape = 21,
  size = 2,
  alpha = 0.9,
  fill = "#cdcabd",
  color = "black",
  aes(
    x = pop_prop,
    y = sev_rate_100k, 
  )
) + 
  
geom_point(
    data = top_inf_df, 
    size = 4,
    shape = 21,
    fill = "#b93f76",
    color = "#cdcabd",
    aes(
      x = pop_prop,
      y = sev_rate_100k, 
    )
) + 
  
geom_point(
  data = top_sev_df, 
  size = 4,
  shape = 21,
  fill = "#6a1c6c",
  color = "#cdcabd",
  aes(
    x = pop_prop,
    y = sev_rate_100k, 
  )
) +   
  
geom_text_repel(
  data = top_cnty_rates_df,
  aes(
    x = pop_prop,
    y = sev_rate_100k,
    label = county
  ),
  nudge_x     = 0.15,
  nudge_y     = 20,
  direction   = "x", 
  hjust       = 0,
  segment.color = NA,  
  size = 3.5
) +   
  
ylim(0,450) +
labs(
    title = "County Proportion of the State's Population and Severe Infection Rate",
    caption = "*Los Angeles County excluded*",
    x = "County Proportion of the State's Population (%)",
    y = "Severe Infection Rate (per 100K)"
) + 
theme_minimal() + 
theme(
    axis.title.x = element_text(margin = margin(t=6), size = 10),
    axis.title.y = element_text(margin = margin(r=6), size = 10),
    axis.text.x = element_text(size = 8),
    axis.text.y = element_text(size = 8, margin = margin(r=15, l = 10)),
    plot.title  = element_text(margin = margin(t=10, b=10)),
    plot.caption = element_text(hjust = 0.5),
    panel.background = element_rect(fill = "#f1f0ea", color = "NA"),
    plot.background = element_rect(fill = "#f1f0ea", color = "NA"),
    plot.margin = margin(t = 8, b = 8, l = 18, r = 18),
)

```







## Infections vs. Infection Rates

Current data show a critical gap between counties with the highest **total number** of infections and those experiencing the highest **rates of infection** and severe disease. This distinction is essential for decision-making in the next phase of the response.

**Los Angeles County** continues to report the largest number of infections statewide, as may be expected given its large population and density, but the burden relative to their population is low. Its infection rate per 100,000 residents is well below the state average, and it has the **lowest severe infection rate** of all counties. In summary: High case counts, but low rates.

In contrast, several rural counties (**Inyo, Imperial, Sierra, Alpine, Tehama, and Plumas**) show the opposite trend. Their total case counts are small, yet their infection and severe infection rates are the **highest in the state**. These counties have far fewer residents, so even a more modest increase in the number of cases translates into a disproportionately high burden for these communities.


::: {layout="[[1], [2]]"}

::: {.column}

##### This has immediate implications for resource planning:

* **Rate-based burden is more concentrated in rural areas.** These counties are being hit hardest relative to their size and have the least surge capacity.

* **Severe infection rates are disproportionately high.** Rural areas seeing the highest rate of severe infections have fewer health care facilities, and often rely on limited or regionalized clinical resources. A surge of even a few severe cases can quickly strain capacity and overwhelm their local healthcare systems.

* **Relying on total case counts alone will mask areas of greatest need.** High-population counties look large on paper, but rural counties are carrying a heavier burden per resident.

:::


::: {.column}

