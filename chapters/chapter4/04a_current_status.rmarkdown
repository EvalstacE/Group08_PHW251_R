```{r, echo = FALSE}

m_inf <- make_rate_map(
  cnty_sf          = ca_cnty_sf,
  ca_state_sf      = ca_state_sf,
  highest_rates_sf = top_cnty_rates,
  cnty_pnts        = ca_cnty_pnts,
  rate_var         = "inf_rate_100k",
  breaks_var       = "inf_rate_breaks",
  palette          = custom_pal,
  title            = "Infection Rate"
) %>% apply_custom_theme()


m_sev <- make_rate_map(
  cnty_sf          = ca_cnty_sf,
  ca_state_sf      = ca_state_sf,
  highest_rates_sf = top_cnty_rates,
  cnty_pnts        = ca_cnty_pnts,
  rate_var         = "sev_rate_100k",
  breaks_var       = "sev_rate_breaks",
  alpha_var        = "alpha_val_sev",
  palette          = custom_pal,
  title            = "Severe Infection Rate",
  scale_factor     = sev_scale
) %>% apply_custom_theme()

# -- tailor scale factor for cases
case_size_map <- ca_cnty_pnts %>%
  group_by(case_breaks) %>%
  summarise(med_val = median(cumulative_infected, na.rm = TRUE),
    .groups = "drop") %>%
  mutate(size_val = scales::rescale(sqrt(med_val), to = c(3, 9))) %>%
  select(case_breaks, size_val) %>%  
  tibble::deframe()

m_cases <- make_rate_map(
  cnty_sf          = ca_cnty_sf,
  ca_state_sf      = ca_state_sf,
  highest_rates_sf = top_cnty_rates,
  cnty_pnts        = ca_cnty_pnts,
  rate_var         = "cumulative_infected",
  breaks_var       = "case_breaks",
  alpha_var        = "alpha_val_case",
  palette          = custom_pal,
  title            = "Cumulative Infections",
  size_values      = case_size_map
) %>% apply_custom_theme()


```







